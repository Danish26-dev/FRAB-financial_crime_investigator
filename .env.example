# ─────────────────────────────────────────────────────────────────────────────
# FRAB frontend environment
#
# Copy this file to `.env` and fill in the values. All vars are read at build
# time by Vite (they MUST be prefixed with VITE_ to reach the client bundle).
# Restart the dev server after changing any of them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Synthetic Bank API (alert source) ───────────────────────────────────────
# The bank backend: alerts queue, customer/account/KYC context, transaction
# feed, dataset stats. When set, the data layer switches from demo/simulated
# mode to live mode (IS_LIVE_BACKEND = true).
VITE_FRAB_API_URL=https://synthetic-bank-deploy-200002205070.asia-south1.run.app

# ── FRAB Confidential Investigation Worker (the AI engine) ───────────────────
# The worker owns the investigation: risk, evidence, findings, network graph,
# regulatory context, agent reasoning and the recommendation. When set,
# IS_WORKER_LIVE = true and the investigation screens (launch, 3D workspace SSE,
# result console) are driven by the worker instead of the bank bundle.
#
# Format: http(s)://<vm-host-or-ip>:<port>  (e.g. http://34.100.20.15:8080)
# Leave unset to keep the worker path inert (bank/demo behaviour unchanged).
#
# NOTE (mixed content): if the frontend is served over HTTPS, the browser will
# block EventSource to a plain-HTTP worker. Use HTTPS or a same-origin proxy
# for any hosted (non-localhost) demo.
VITE_FRAB_WORKER_URL=

# Optional auth token for the worker. Sent as a ?token= query param because
# native EventSource cannot set request headers. Leave blank if the worker
# requires no auth (the default for the demo).
VITE_FRAB_WORKER_TOKEN=

# ── FRAB Voice Escalation service (Vapi adapter microservice) ────────────────
# The isolated voice microservice. When set, IS_VOICE_LIVE = true and the Case
# Book "Voice Escalation" (page 08) drives a real call: the analyst escalates,
# the service calls the customer via Vapi, and the structured assessment comes
# back into the same case. The frontend NEVER talks to Vapi directly — all
# secrets are server-side in the voice service.
#
# Format: http(s)://<host>:<port>  (e.g. http://localhost:8090 for the mock).
# Leave unset to keep the voice path inert (Case Book shows "not connected").
VITE_FRAB_VOICE_URL=

# Optional demo phone override for voice escalation. Normally the voice service
# resolves the customer phone itself (backend is source of truth); this is only
# for forcing a specific number in a demo. Not required.
VITE_FRAB_VOICE_TEST_PHONE=
